PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/examiq
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=ChangeThisAdminPass1
# Model 1: Gemini (free key from Google AI Studio)
GEMINI_API_KEY=your_api_key
GEMINI_MODEL=gemini-2.0-flash
# Model 2: Groq (default). For xAI Grok use SECOND_AI_BASE_URL=https://api.x.ai/v1 and a Grok model name.
SECOND_AI_KEY=your_api_key
SECOND_AI_BASE_URL=https://api.groq.com/openai/v1
SECOND_AI_MODEL=openai/gpt-oss-120b
# Which model is tried first: gemini or second. The other is the automatic fallback.
AI_PRIMARY=second
# AI marking speed limits. Set AI_RPM to your free key's requests per minute (check Google AI Studio / Groq console).
AI_RPM=10
AI_CONCURRENCY=3
# Set to 1 when deployed behind a proxy (Render, Railway, Nginx)
TRUST_PROXY=
